<div
  id="pwa-install-prompt"
  class="pwa-install-prompt"
  role="dialog"
  aria-live="polite"
  aria-labelledby="pwa-install-title"
  hidden
>
  <div class="pwa-install-info">
    <img
      class="pwa-install-logo"
      src="/cit-thumbnail.png"
      alt=""
      width="44"
      height="44"
    />
    <div class="pwa-install-copy">
      <strong id="pwa-install-title">Install YourRoute</strong>
      <span id="pwa-install-message"
        >Keep the campus navigator ready from your home screen.</span
      >
      <div id="pwa-ios-install-steps" class="ios-install-steps" hidden>
        <div class="ios-install-step">
          <span class="ios-step-number">1</span>
          <span>
            Tap Safari's Share button
            <svg
              aria-label="Share"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 3v12"></path>
              <path d="m8 7 4-4 4 4"></path>
              <path d="M5 11v9h14v-9"></path>
            </svg>
            in the bottom toolbar.
          </span>
        </div>
        <div class="ios-install-step">
          <span class="ios-step-number">2</span>
          <span>Scroll down and tap <strong>Add to Home Screen</strong>.</span>
        </div>
        <div class="ios-install-step">
          <span class="ios-step-number">3</span>
          <span>Enable <strong>Open as Web App</strong>, then tap Add.</span>
        </div>
        <div class="ios-share-direction" aria-hidden="true">
          <span>Safari Share button is below</span>
          <span class="ios-down-arrow">&darr;</span>
        </div>
      </div>
    </div>
  </div>
  <div class="pwa-install-actions">
    <button type="button" id="pwa-install-action">Install</button>
    <button
      type="button"
      id="pwa-install-close"
      aria-label="Dismiss install prompt"
    >
      Later
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const standalone =
      window.matchMedia("(display-mode: standalone)").matches ||
      window.navigator.standalone === true;
    if (standalone) return;

    const promptEl = document.getElementById("pwa-install-prompt");
    const titleEl = document.getElementById("pwa-install-title");
    const messageEl = document.getElementById("pwa-install-message");
    const iosStepsEl = document.getElementById("pwa-ios-install-steps");
    const actionButton = document.getElementById("pwa-install-action");
    const closeButton = document.getElementById("pwa-install-close");
    if (
      !promptEl ||
      !titleEl ||
      !messageEl ||
      !iosStepsEl ||
      !actionButton ||
      !closeButton
    ) {
      return;
    }

    const ua = window.navigator.userAgent;
    const isiOS =
      /iphone|ipad|ipod/i.test(ua) ||
      (window.navigator.platform === "MacIntel" &&
        window.navigator.maxTouchPoints > 1);
    const isAndroid = /android/i.test(ua);
    let deferredInstallPrompt = null;
    let promptVisible = false;
    let pendingMode = null;
    let modalObserver = null;

    const hasBlockingModal = () => document.querySelector(".modal-set");

    const stopWaitingForModal = () => {
      modalObserver?.disconnect();
      modalObserver = null;
    };

    const dismiss = () => {
      pendingMode = null;
      stopWaitingForModal();
      promptEl.hidden = true;
    };

    const applyPrompt = (mode) => {
      promptVisible = true;
      pendingMode = null;
      stopWaitingForModal();
      promptEl.dataset.mode = mode;
      promptEl.hidden = false;
      iosStepsEl.hidden = true;
      actionButton.setAttribute("aria-expanded", "false");

      if (mode === "ios") {
        titleEl.textContent = "Install YourRoute";
        messageEl.textContent =
          "On iPhone or iPad: install through Safari's Share menu.";
        actionButton.textContent = "Show Steps";
        actionButton.disabled = false;
        return;
      }

      if (deferredInstallPrompt) {
        titleEl.textContent = "Install YourRoute";
        messageEl.textContent =
          "Open faster next time and keep offline access ready.";
        actionButton.textContent = "Install";
        actionButton.disabled = false;
        return;
      }

      titleEl.textContent = "Install YourRoute";
      messageEl.textContent = isAndroid
        ? "If the install button is unavailable, use Chrome menu, then Add to Home screen."
        : "Use your browser menu to add YourRoute to your home screen.";
      actionButton.textContent = "Got it";
      actionButton.disabled = false;
    };

    const flushPendingPrompt = () => {
      if (!pendingMode || promptVisible) return;

      if (hasBlockingModal()) {
        if (!modalObserver) {
          modalObserver = new MutationObserver(() => {
            if (!hasBlockingModal()) {
              window.setTimeout(flushPendingPrompt, 260);
            }
          });
          modalObserver.observe(document.body, {
            childList: true,
            subtree: true,
          });
        }
        return;
      }

      applyPrompt(pendingMode);
    };

    const showPrompt = (mode) => {
      if (promptVisible) {
        if (mode === "native" && deferredInstallPrompt) {
          applyPrompt(mode);
        }
        return;
      }

      pendingMode = mode === "native" || !pendingMode ? mode : pendingMode;
      window.setTimeout(flushPendingPrompt, 0);
    };

    window.addEventListener("beforeinstallprompt", (event) => {
      event.preventDefault();
      deferredInstallPrompt = event;
      showPrompt("native");
    });

    window.addEventListener("appinstalled", () => {
      deferredInstallPrompt = null;
      promptEl.hidden = true;
    });

    actionButton.addEventListener("click", async () => {
      if (promptEl.dataset.mode === "ios") {
        iosStepsEl.hidden = false;
        messageEl.textContent = "Follow these steps in Safari:";
        actionButton.textContent = "Steps Shown";
        actionButton.disabled = true;
        actionButton.setAttribute("aria-expanded", "true");
        return;
      }

      if (!deferredInstallPrompt) {
        dismiss();
        return;
      }

      const promptEvent = deferredInstallPrompt;
      deferredInstallPrompt = null;
      promptEl.hidden = true;
      promptEvent.prompt();
      await promptEvent.userChoice;
    });

    closeButton.addEventListener("click", dismiss);

    window.setTimeout(() => {
      if (promptVisible) return;
      if (isiOS) {
        showPrompt("ios");
      } else {
        showPrompt("fallback");
      }
    }, 1400);
  })();
</script>

<style>
  .pwa-install-prompt[hidden] {
    display: none;
  }

  .pwa-install-prompt {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 80;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: min(35rem, calc(100vw - 1rem));
    padding: 0.75rem;
    color: #1d1d1d;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 0.5rem;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.22);
    transform: translateX(-50%);
    backdrop-filter: blur(12px);
  }

  .pwa-install-copy {
    display: grid;
    min-width: 0;
    gap: 0.18rem;
  }

  .pwa-install-info {
    display: flex;
    flex: 1 1 auto;
    align-items: flex-start;
    gap: 0.65rem;
    min-width: 0;
  }

  .pwa-install-logo {
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
  }

  .pwa-install-copy > strong,
  #pwa-install-message {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pwa-install-copy strong {
    font-size: 0.95rem;
    line-height: 1.1;
  }

  #pwa-install-message {
    color: #555555;
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .ios-install-steps[hidden] {
    display: none;
  }

  .ios-install-steps {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.4rem;
    padding-top: 0.6rem;
    color: #333333;
    font-size: 0.78rem;
    line-height: 1.35;
    border-top: 1px solid #e4dddd;
  }

  .ios-install-step {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    align-items: start;
    gap: 0.4rem;
  }

  .ios-install-step > span:last-child {
    display: inline;
  }

  .ios-install-step svg {
    display: inline-block;
    margin: -0.15rem 0.1rem;
    color: #7b1113;
    vertical-align: middle;
  }

  .ios-step-number {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 850;
    background: #7b1113;
    border-radius: 50%;
  }

  .ios-share-direction {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 0.15rem;
    color: #7b1113;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .ios-down-arrow {
    font-size: 1.25rem;
    line-height: 0.8;
  }

  .pwa-install-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.45rem;
  }

  .pwa-install-actions button {
    box-sizing: border-box;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    font-size: 0.82rem;
    font-weight: 850;
    line-height: 1;
    border-radius: 0.45rem;
    cursor: pointer;
  }

  #pwa-install-action {
    color: #ffffff;
    background: hsl(5, 53%, 32%);
  }

  #pwa-install-action:disabled {
    cursor: default;
    opacity: 0.72;
  }

  #pwa-install-close {
    color: hsl(5, 53%, 32%);
    background: #f4eeee;
  }

  @media screen and (max-width: 36rem) {
    .pwa-install-prompt {
      align-items: stretch;
      flex-direction: column;
      gap: 0.65rem;
    }

    .pwa-install-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .pwa-install-actions button {
      justify-content: center;
      text-align: center;
    }
  }
</style>
