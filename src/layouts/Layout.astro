---
import { pwaInfo } from "virtual:pwa-info";
import PWAInstallPrompt from "../components/PWAInstallPrompt.astro";
import ReloadPrompt from "../components/ReloadPrompt.astro";
import "../styles/font-face.css";
import Analytics from "@vercel/analytics/astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.ico?v=4" sizes="48x48" />
    <link rel="icon" href="/pwa-48x48.png?v=4" sizes="48x48" type="image/png" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png?v=4"
      sizes="180x180"
    />
    <meta name="theme-color" content="#872f38" />
    <meta name="generator" content={Astro.generator} />
    <title>YourRoute</title>
    <meta
      name="description"
      content="YourRoute is an offline website built to help CITU students find their rooms across the Cebu Institute of Technology - University campus."
    />

    <meta property="og:url" content="/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="YourRoute" />
    <meta
      property="og:description"
      content="YourRoute is an offline website built to help CITU students find their rooms across the Cebu Institute of Technology - University campus."
    />
    <meta property="og:image" content="/socmed.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="" />
    <meta property="twitter:url" content="/" />
    <meta
      name="twitter:title"
      content="YourRoute utility for finding rooms around CITU"
    />
    <meta
      name="twitter:description"
      content="YourRoute is an offline website built to help CITU students find their rooms across the Cebu Institute of Technology - University campus."
    />
    <meta name="twitter:image" content="/socmed.png" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js");
      }
    </script>
    <style is:global>
      * {
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          sans-serif;
      }
      button {
        all: unset;
      }
      button,
      a,
      input {
        outline: 2px solid transparent;
        outline-offset: 2px;

        &:focus-visible {
          outline-color: hsl(5, 53%, 32%);
        }
      }
      html {
        min-height: 100%;
        background-color: hsl(0, 0%, 96%);
      }
      body {
        min-height: 100%;
        overscroll-behavior: none;
        touch-action: manipulation;
      }
    </style>
  </head>
  <body>
    <slot />
    <PWAInstallPrompt />
    <ReloadPrompt />
    <Analytics />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  @media only screen and (max-width: 600px) {
    .container {
      padding: 1rem;
    }
  }
</style>
