{
  "name": "YourRoute",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "forwardPorts": [4321, 4322, 4323, 4983],
  "portsAttributes": {
    "4321": {
      "label": "Astro dev server",
      "onAutoForward": "openPreview"
    },
    "4322": {
      "label": "Astro alternate dev server",
      "onAutoForward": "notify"
    },
    "4323": {
      "label": "Astro alternate dev server",
      "onAutoForward": "notify"
    },
    "4983": {
      "label": "Drizzle Studio",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "PATH": "/home/node/.bun/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash && /home/node/.bun/bin/bun install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "svelte.svelte-vscode",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
